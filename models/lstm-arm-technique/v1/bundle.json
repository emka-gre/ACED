{
  "id": "lstm-arm-technique",
  "version": "1.0.0",
  "model_kind": "sequence",
  "model_file": "model.keras",
  "features": [
    "left_elbow_angle",
    "right_elbow_angle",
    "right_wrist_shoulder_dist",
    "left_head_elbow_dist",
    "right_head_wrist_dist",
    "right_hip_elbow_dist",
    "left_wrist_shoulder_dist",
    "left_elbow_height_rel_shoulder"
  ],
  "window_length": 60,
  "stride": 20,
  "landmarks": [
    "nose",
    "left_shoulder",
    "right_shoulder",
    "left_elbow",
    "right_elbow",
    "left_wrist",
    "right_wrist",
    "left_hip",
    "right_hip"
  ],
  "threshold": 0.5,
  "scaling": "external",
  "confidence": "probability",
  "sound_class": 1,
  "trained_on": "2026-04-07",
  "metrics": {},
  "scaler_provenance": "fitted during LSTM training on df_X_m_train_3split_2.csv (1588 windows); verified in this build to be bitwise identical to a refit from that file",
  "notes": "Classifies arm technique only, from 2D pose. Trained on a small set of climbers in one gym, labelled by one person. One climber per video."
}
